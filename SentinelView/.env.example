# Wazuh Manager REST API (default port 55000)
VITE_WAZUH_API_URL=https://<EC2_ELASTIC_IP>:55000
VITE_WAZUH_API_USER=wazuh-wui
VITE_WAZUH_API_PASS=changeme

# Wazuh Indexer / OpenSearch (default port 9200) — alert source
VITE_WAZUH_INDEXER_URL=https://<EC2_ELASTIC_IP>:9200
VITE_WAZUH_INDEXER_USER=admin
VITE_WAZUH_INDEXER_PASS=changeme

# Optional: local AI (Ollama) for triage/briefing/assistant
VITE_AI_USE_MOCK=true
VITE_OLLAMA_HOST=http://localhost:11434
VITE_AI_MODEL=qwen2.5:14b